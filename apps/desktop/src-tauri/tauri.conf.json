{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CoSpace",
  "version": "0.2.0",
  "identifier": "com.cospace.desktop",
  "build": {
    "frontendDist": "../launcher"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CoSpace",
        "width": 1180,
        "height": 820,
        "minWidth": 880,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://hanfang5057-byte.github.io/co-space/desktop/latest.json"],
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "CoSpace document review workbench",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/": ""
    },
    "externalBin": [
      "binaries/cospace-node"
    ]
  }
}
