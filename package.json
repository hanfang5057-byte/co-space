{
  "name": "cospace-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/review-core",
    "packages/review-ui",
    "packages/transport-mcp",
    "packages/transport-http",
    "adapters/dsh"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --test test/*.test.js",
    "build:client": "node scripts/build-client.mjs",
    "build:dsh": "npm run build:client && node scripts/build-dsh.mjs",
    "pack:dsh": "npm run build:dsh && npm pack ./dist/dsh-plugin --pack-destination ./dist",
    "verify:dsh-package": "npm run build:dsh && node scripts/verify-dsh-package.mjs && npm pack ./dist/dsh-plugin --dry-run"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "markdown-it": "^15.0.3"
  }
}
