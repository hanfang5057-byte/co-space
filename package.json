{
  "name": "dsh-plugin-space",
  "version": "0.1.1",
  "description": "Review agent-proposed edits to personal documents: create documents, accept or reject each suggestion, and send comments to the current conversation.",
  "type": "module",
  "license": "MIT",
  "author": "hanfang",
  "homepage": "https://github.com/hanfang5057-byte/dsh-space",
  "repository": {
    "type": "git",
    "url": "https://github.com/hanfang5057-byte/dsh-space.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "documents",
    "review",
    "suggestions",
    "comments"
  ],
  "engines": {
    "node": ">=24",
    "dsh": "^0.2.2-rc.5"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --test test/*.test.js",
    "build:client": "node scripts/build-client.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "markdown-it": "^15.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "server",
    "src",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
