{
  "name": "@local/dsh-space",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Syncthing-backed shared spaces with open-text documents, tables, and slides",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "client-src",
    "server",
    "locale",
    "docs",
    "icon.svg",
    "cordis.patch.yml",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "engines": {
    "dsh": "^0.2.2-rc.5"
  },
  "scripts": {
    "build:client": "node scripts/generate-rdg-styles.mjs && node scripts/build-client.mjs"
  },
  "dependencies": {
    "@marp-team/marp-core": "^4.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "gray-matter": "^4.0.3",
    "markdown-it": "^15.0.3",
    "node-diff3": "^4.0.0",
    "sanitize-html": "^2.18.2",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "esbuild": "^0.25.0",
    "react-aria-components": "^1.22.1",
    "react-data-grid": "7.0.0-beta.47"
  }
}
