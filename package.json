{
  "name": "cospace-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/review-core",
    "packages/host-api",
    "packages/review-ui",
    "packages/adapter-contract",
    "packages/transport-mcp",
    "packages/transport-http",
    "packages/local-runtime",
    "adapters/dsh",
    "apps/local-server"
  ],
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "pretest": "npm run build:client",
    "test": "node --test test/*.test.js",
    "pretest:fast": "npm run build:client",
    "test:fast": "node scripts/test-fast.mjs",
    "precheck": "npm run build:client && npm run verify:architecture",
    "check": "node --test test/*.test.js",
    "build:client": "node scripts/build-client.mjs",
    "build:market": "node scripts/build-market.mjs",
    "build:dsh": "npm run build:client && node scripts/build-dsh.mjs && node scripts/build-market.mjs",
    "dev:dsh": "node scripts/dev-dsh.mjs",
    "dev:local": "node scripts/dev-local.mjs",
    "build:site": "node scripts/build-site.mjs",
    "local-server:build": "npm run build --workspace @hanfang5057/co-space",
    "local-server:pack": "npm run pack --workspace @hanfang5057/co-space",
    "local-server:verify-package": "npm run verify-package --workspace @hanfang5057/co-space",
    "local-server:mcp": "npm run mcp --workspace @hanfang5057/co-space",
    "local-server:web": "npm run web --workspace @hanfang5057/co-space",
    "verify:architecture": "node scripts/verify-adapter-boundaries.mjs",
    "pack:npm": "node scripts/pack-dsh.mjs",
    "pack:dsh": "node scripts/pack-dsh.mjs",
    "verify:dsh-package": "npm run build:dsh && npm run verify:architecture && node scripts/verify-dsh-package.mjs && npm pack ./dist/dsh-plugin --dry-run",
    "check:theme": "node scripts/check-theme.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "markdown-it": "^15.0.3"
  }
}
