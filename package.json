{
  "name": "@local/dsh-space",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Syncthing-backed shared spaces with open-text documents, tables, and slides",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "client-src",
    "server",
    "locale",
    "docs",
    "icon.svg",
    "cordis.patch.yml",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "engines": {
    "dsh": "^0.2.2-rc.5"
  },
  "scripts": {
    "build:client": "node scripts/generate-crepe-styles.mjs && node scripts/build-client.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "check": "node scripts/contract-check.mjs && node scripts/smoke.mjs"
  },
  "dependencies": {
    "@milkdown/crepe": "^7.23.0",
    "@milkdown/kit": "^7.23.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "markdown-it": "^15.0.3",
    "node-diff3": "^4.0.0",
    "sanitize-html": "^2.18.2",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "react-aria-components": "^1.22.1"
  }
}
