{
  "name": "cospace-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/review-core",
    "packages/review-ui",
    "packages/transport-mcp",
    "packages/transport-http",
    "adapters/dsh"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --test test/*.test.js",
    "build:client": "node scripts/build-client.mjs",
    "build:market": "node scripts/build-market.mjs",
    "build:dsh": "npm run build:client && node scripts/build-dsh.mjs && node scripts/build-market.mjs",
    "dev:dsh": "node scripts/dev-dsh.mjs",
    "build:workbuddy": "node adapters/workbuddy/build.mjs",
    "build:site": "node scripts/build-site.mjs",
    "verify:workbuddy-package": "npm run build:workbuddy && node adapters/workbuddy/verify.mjs",
    "pack:workbuddy": "node scripts/pack-npm.mjs workbuddy",
    "pack:npm": "node scripts/pack-npm.mjs",
    "pack:dsh": "node scripts/pack-npm.mjs dsh",
    "verify:dsh-package": "npm run build:dsh && node scripts/verify-dsh-package.mjs && npm pack ./dist/dsh-plugin --dry-run"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "markdown-it": "^15.0.3"
  }
}
